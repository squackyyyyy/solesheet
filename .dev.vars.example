# Server-only Worker secret. This is Cloudflare's official always-pass test
# secret and must only be used on localhost or in automated tests.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Local-only HMAC key for signing the short-lived survey continuation token.
# Generate a separate random secret for production; never reuse this value there.
SURVEY_SUBMISSION_SECRET=local-only-survey-signing-secret-2026
