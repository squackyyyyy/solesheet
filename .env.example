# Public Turnstile sitekey embedded in the browser bundle.
# This is Cloudflare's official always-pass test sitekey; replace it in the
# production build environment with the sitekey from the SoleSheet widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Canonical public origin used by metadata and the analytics hostname gate.
# Keep the analytics token empty until solesheet.app is the production domain.
NEXT_PUBLIC_SITE_URL=https://solesheet.app

# Public Cloudflare Web Analytics site token; this is intentionally dormant.
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
