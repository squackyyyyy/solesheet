{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "solesheet",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],
	"secrets": {
		"required": ["TURNSTILE_SECRET_KEY", "SURVEY_SUBMISSION_SECRET"]
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "solesheet-waitlist",
			"database_id": "502f9965-9ccc-420c-8a1c-f55cd8ded88d",
			"migrations_dir": "migrations"
		}
	]
}
